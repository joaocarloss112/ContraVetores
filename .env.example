# Referência das variáveis de ambiente. O Django não lê este arquivo sozinho:
# exporte as variáveis no terminal ou cadastre no painel da hospedagem. Nunca versione segredos.

# Em produção: DEBUG=false e uma SECRET_KEY longa e aleatória.
DEBUG=true
SECRET_KEY=troque-por-uma-chave-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL o Django usa o db.sqlite3 local.
# PostgreSQL (Supabase, Render, Neon ou local):
# DATABASE_URL=postgresql://usuario:senha@host:5432/contravetores

# Domínios do front-end autorizados a chamar a API (separados por vírgula).
# CORS_ALLOWED_ORIGINS=https://contravetores.vercel.app
# CSRF_TRUSTED_ORIGINS=https://contravetores-api.onrender.com

# Serve as fotos enviadas pelo próprio Django (padrão: igual ao DEBUG).
# SERVE_MEDIA=true
